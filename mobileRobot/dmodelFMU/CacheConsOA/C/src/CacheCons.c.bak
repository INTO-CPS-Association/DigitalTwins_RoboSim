		     	     }
		     	else if ((*state).status.type == create_STATUS_EXIT_STATE().type) {
		     	     	{
		     	     		char _s0[256];
		     	     		sprintf(_s0, "%s", "		Exiting state VHFEnabled");
		     	     		fprintf(log_file, "DEBUG: %s\n", _s0);
