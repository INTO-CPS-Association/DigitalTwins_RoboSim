		     	     			(*state).status = create_STATUS_ENTER_STATE();
		     	     			return create_RESULT_CONT();
		     	     		} else if (	(*inputstate)._transition_.type == create_TRANSITIONS_stm_ref2_stm_ref2_t1().type
		     	     		            ) {
